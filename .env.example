# MongoDB Connection (Local or MongoDB Atlas Cloud)
# For Local MongoDB:
# ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust
# For MongoDB Atlas Cloud (Free tier from mongodb.com):
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlust?retryWrites=true&w=majority

# Session Secret (any random secure string)
SESSION_SECRET=wanderlust_major_project_super_secret_key_2026

# Cloudinary Credentials (Free tier from cloudinary.com for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Public Access Token (Optional: Free tier from mapbox.com - if omitted, Leaflet OpenStreetMap automatically works)
MAP_TOKEN=your_mapbox_public_token

# Application Port (Default: 8080)
PORT=8080
