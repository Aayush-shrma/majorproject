<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <!-- Action buttons (Print / Back) -->
      <div class="d-flex align-items-center justify-content-between mb-4 no-print">
        <a href="/bookings" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
          <i class="fa-solid fa-arrow-left me-1"></i> Back to My Trips
        </a>
        <button onclick="window.print()" class="btn btn-danger rounded-pill px-4 py-2 fw-bold" style="background: var(--primary-gradient); border: none;">
          <i class="fa-solid fa-print me-2"></i> Print / Save PDF Receipt
        </button>
      </div>

      <!-- ── OFFICIAL INVOICE CARD ── -->
      <div class="card rounded-4 border-0 shadow p-4 p-md-5 invoice-card" style="background: var(--bg-card); color: var(--text-main);">
        
        <!-- Header -->
        <div class="d-flex align-items-start justify-content-between pb-4 border-bottom" style="border-color: var(--border-color) !important;">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="fa-solid fa-compass text-danger fs-3"></i>
              <span class="fs-4 fw-extrabold text-danger">Wanderlust</span>
            </div>
            <small class="text-muted d-block">Official Booking Confirmation & Tax Invoice</small>
            <small class="text-muted">GSTIN: 24AAACW8492K1Z9 · Verified Accommodation Platform</small>
          </div>

          <div class="text-end">
            <span class="badge bg-success rounded-pill px-3 py-2 fs-6 mb-2">
              <i class="fa-solid fa-circle-check me-1"></i> Confirmed & Paid
            </span>
            <div class="fw-bold" style="font-size: 0.9rem;">Invoice: <%= booking.bookingCode %></div>
            <small class="text-muted"><%= new Date(booking.createdAt).toLocaleDateString("en-IN", { day:'numeric', month:'short', year:'numeric' }) %></small>
          </div>
        </div>

        <!-- Guest & Stay Metadata -->
        <div class="row g-4 my-3">
          <div class="col-sm-6">
            <h6 class="text-uppercase fw-bold text-muted small mb-2">Guest Details</h6>
            <div class="fw-bold fs-6"><%= booking.guest ? booking.guest.username : 'Guest' %></div>
            <div class="text-muted small"><%= booking.guest ? booking.guest.email : '' %></div>
            <div class="text-muted small">Guests: <%= booking.guestsCount %> Person(s)</div>
          </div>

          <div class="col-sm-6 text-sm-end">
            <h6 class="text-uppercase fw-bold text-muted small mb-2">Property & Host</h6>
            <div class="fw-bold fs-6"><%= booking.listing ? booking.listing.title : 'Wanderlust Property' %></div>
            <div class="text-muted small"><%= booking.listing ? booking.listing.location : '' %>, <%= booking.listing ? booking.listing.country : '' %></div>
            <div class="text-muted small">Host: <%= booking.listing && booking.listing.owner ? booking.listing.owner.username : 'Superhost' %></div>
          </div>
        </div>

        <!-- Dates Schedule Box -->
        <div class="p-3 my-3 rounded-3 bg-light text-dark">
          <div class="row text-center g-3">
            <div class="col-4 border-end">
              <span class="text-muted small d-block">CHECK-IN</span>
              <strong><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day:'numeric', month:'short', year:'numeric' }) %></strong>
              <small class="text-muted d-block">From 2:00 PM</small>
            </div>
            <div class="col-4 border-end">
              <span class="text-muted small d-block">CHECK-OUT</span>
              <strong><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day:'numeric', month:'short', year:'numeric' }) %></strong>
              <small class="text-muted d-block">Until 11:00 AM</small>
            </div>
            <div class="col-4">
              <span class="text-muted small d-block">TOTAL STAY</span>
              <strong><%= booking.nights %> Night<%= booking.nights > 1 ? 's' : '' %></strong>
              <small class="text-muted d-block"><%= booking.guestsCount %> Guest(s)</small>
            </div>
          </div>
        </div>

        <!-- Itemized Price Table -->
        <h6 class="text-uppercase fw-bold text-muted small mt-4 mb-3">Billing & Tax Breakdown</h6>
        <div class="table-responsive">
          <table class="table table-borderless align-middle mb-0">
            <thead class="border-bottom" style="border-color: var(--border-color) !important;">
              <tr class="text-muted small">
                <th>Description</th>
                <th class="text-center">Rate</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody class="border-bottom" style="border-color: var(--border-color) !important;">
              <tr>
                <td>Accommodation Charge (<%= booking.listing ? booking.listing.title : 'Stay' %>)</td>
                <td class="text-center">&#8377;<%= Math.round(booking.basePrice / booking.nights).toLocaleString("en-IN") %></td>
                <td class="text-center"><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></td>
                <td class="text-end fw-semibold">&#8377;<%= booking.basePrice.toLocaleString("en-IN") %></td>
              </tr>
              <tr>
                <td>Standard Cleaning & Sanitation Fee</td>
                <td class="text-center">-</td>
                <td class="text-center">1</td>
                <td class="text-end fw-semibold">&#8377;<%= (booking.cleaningFee || 500).toLocaleString("en-IN") %></td>
              </tr>
              <tr>
                <td>Wanderlust Platform Service Fee (5%)</td>
                <td class="text-center">-</td>
                <td class="text-center">1</td>
                <td class="text-end fw-semibold">&#8377;<%= (booking.serviceFee || Math.round(booking.basePrice * 0.05)).toLocaleString("en-IN") %></td>
              </tr>
              <tr>
                <td>Goods and Services Tax (GST 18%)</td>
                <td class="text-center">18%</td>
                <td class="text-center">1</td>
                <td class="text-end fw-semibold">&#8377;<%= (booking.gstAmount || 0).toLocaleString("en-IN") %></td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3" class="fs-5 fw-bold pt-3">Total Amount Paid</td>
                <td class="text-end fs-4 fw-extrabold text-danger pt-3">&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Payment Info Footer -->
        <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-between gap-3 text-muted small" style="border-color: var(--border-color) !important;">
          <div>
            <strong>Payment Method:</strong> <%= booking.paymentMethod || 'Razorpay Instant UPI' %><br>
            <strong>Transaction ID:</strong> <%= booking.paymentId || 'PAY_WL984210' %>
          </div>
          <div class="text-sm-end">
            <i class="fa-solid fa-shield-halved text-success me-1"></i> 100% Verified Secure Booking<br>
            24x7 Support: support@wanderlust.com
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
