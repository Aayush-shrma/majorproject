<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-7 col-sm-9">

      <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background: var(--bg-card);">
        <div class="card-body p-4 p-md-5">

          <!-- Logo & Title -->
          <div class="text-center mb-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; background: var(--primary-gradient); color: white;">
              <i class="fa-solid fa-compass fs-2"></i>
            </div>
            <h3 class="fw-bold mt-2 mb-1">Create Account</h3>
            <p class="text-muted small">Join Wanderlust to unlock luxury stays, host properties & save wishlists.</p>
          </div>

          <form action="/signup" method="POST" class="needs-validation" novalidate>

            <div class="mb-3">
              <label for="username" class="form-label fw-semibold small">Choose a Username</label>
              <input
                name="username"
                id="username"
                type="text"
                class="form-control rounded-3 py-2"
                placeholder="e.g. wanderlust_traveler"
                required />
              <div class="invalid-feedback">Please choose a valid username.</div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold small">Email Address</label>
              <input
                name="email"
                id="email"
                type="email"
                class="form-control rounded-3 py-2"
                placeholder="you@example.com"
                required />
              <div class="invalid-feedback">Please enter a valid email address.</div>
            </div>

            <div class="mb-4">
              <label for="password" class="form-label fw-semibold small">Password</label>
              <div class="input-group">
                <input
                  name="password"
                  id="password"
                  type="password"
                  class="form-control rounded-start-3 py-2"
                  placeholder="Create a strong password"
                  required />
                <button
                  class="btn btn-outline-secondary rounded-end-3"
                  type="button"
                  onclick="togglePwd('password', this)">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
              <div class="invalid-feedback">Please enter a password.</div>
            </div>

            <button
              class="btn w-100 py-3 fw-bold rounded-pill text-white shadow-sm"
              type="submit"
              style="background: var(--primary-gradient); border: none; font-size: 1rem;">
              <i class="fa-solid fa-user-plus me-2"></i> Sign Up & Start Exploring
            </button>

          </form>

          <hr class="my-4" style="border-color: var(--border-color) !important;" />

          <p class="text-center text-muted mb-0 small">
            Already have an account?
            <a href="/login" class="fw-bold text-danger text-decoration-none ms-1">Log in here</a>
          </p>

        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }
</script>
