<% layout("layouts/boilerplate") %>

<div class="container-fluid px-3 px-md-5 my-5">
  <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
    <div>
      <h2 class="fw-bold mb-1" style="color: var(--text-main);">Manage Host Reservations</h2>
      <p class="text-muted mb-0">Overview of all guest bookings across your hosted properties.</p>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
    </a>
  </div>

  <div class="card rounded-4 border shadow-sm overflow-hidden" style="border-color: var(--border-color) !important; background: var(--bg-card);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr class="text-muted small">
            <th>Booking Code</th>
            <th>Property</th>
            <th>Guest</th>
            <th>Schedule</th>
            <th>Guests</th>
            <th>Earnings</th>
            <th>Status</th>
            <th>Payment</th>
            <th class="text-end">Invoice</th>
          </tr>
        </thead>
        <tbody>
          <% if (reservations.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="fa-solid fa-calendar-xmark fs-2 mb-2 d-block"></i>
                No guest reservations recorded for your listings yet.
              </td>
            </tr>
          <% } else { %>
            <% for (let r of reservations) { %>
              <tr>
                <td class="fw-bold"><%= r.bookingCode %></td>
                <td>
                  <div class="fw-semibold text-truncate" style="max-width: 180px;"><%= r.listing ? r.listing.title : 'Listing' %></div>
                  <small class="text-muted"><%= r.listing ? r.listing.location : '' %></small>
                </td>
                <td>
                  <div class="fw-semibold"><%= r.guest ? r.guest.username : 'Guest' %></div>
                  <small class="text-muted"><%= r.guest ? r.guest.email : '' %></small>
                </td>
                <td class="small">
                  <%= new Date(r.checkIn).toLocaleDateString("en-IN", { day:'numeric', month:'short' }) %> - <%= new Date(r.checkOut).toLocaleDateString("en-IN", { day:'numeric', month:'short', year:'numeric' }) %><br>
                  <span class="text-muted">(<%= r.nights %> nights)</span>
                </td>
                <td><%= r.guestsCount %> Person(s)</td>
                <td class="fw-bold text-success">&#8377;<%= r.basePrice.toLocaleString("en-IN") %></td>
                <td>
                  <span class="badge <%= r.status === 'confirmed' ? 'bg-success' : (r.status === 'completed' ? 'bg-secondary' : 'bg-danger') %> rounded-pill px-3 py-1">
                    <%= r.status %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-light text-dark border rounded-pill"><%= r.paymentStatus %></span>
                </td>
                <td class="text-end">
                  <a href="/bookings/<%= r._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                    <i class="fa-solid fa-file-invoice"></i> Receipt
                  </a>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
