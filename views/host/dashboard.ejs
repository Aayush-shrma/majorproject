<% layout("layouts/boilerplate") %>

<div class="container-fluid px-3 px-md-5 my-5">
  
  <!-- ── DASHBOARD HEADER ── -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-success rounded-pill px-3 py-1 fw-bold">Host Portal</span>
        <h2 class="fw-bold mb-0" style="color: var(--text-main);">Performance & Revenue Analytics</h2>
      </div>
      <p class="text-muted mb-0">Track real-time occupancy, guest reservations, and earnings metrics across your portfolio.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <a href="/bookings/host/manage" class="btn btn-outline-dark rounded-pill px-4 fw-semibold" style="border-color: var(--border-color); color: var(--text-main);">
        <i class="fa-solid fa-list-check me-1"></i> Reservations (<%= bookings.length %>)
      </a>
      <a href="/listings/new" class="btn btn-danger rounded-pill px-4 fw-bold" style="background: var(--primary-gradient); border: none;">
        <i class="fa-solid fa-plus me-1"></i> Add New Property
      </a>
    </div>
  </div>

  <!-- ── 4 KPI SUMMARY CARDS ── -->
  <div class="row g-4 mb-4">
    
    <!-- Total Revenue -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="d-flex align-items-center justify-content-between">
          <div class="kpi-icon-wrap" style="background: rgba(255, 56, 92, 0.1); color: #ff385c;">
            <i class="fa-solid fa-indian-rupee-sign"></i>
          </div>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
            +18.4% MoM
          </span>
        </div>
        <div class="kpi-value">&#8377;<%= stats.totalEarnings.toLocaleString("en-IN") %></div>
        <div class="kpi-label">Total Gross Earnings</div>
      </div>
    </div>

    <!-- Total Bookings -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="d-flex align-items-center justify-content-between">
          <div class="kpi-icon-wrap" style="background: rgba(0, 132, 137, 0.1); color: #008489;">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1 small">
            Verified
          </span>
        </div>
        <div class="kpi-value"><%= stats.totalBookingsCount %></div>
        <div class="kpi-label">Completed Reservations</div>
      </div>
    </div>

    <!-- Active Listings -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="d-flex align-items-center justify-content-between">
          <div class="kpi-icon-wrap" style="background: rgba(255, 180, 0, 0.1); color: #ffb400;">
            <i class="fa-solid fa-house-chimney"></i>
          </div>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
            Live
          </span>
        </div>
        <div class="kpi-value"><%= stats.activeListingsCount %></div>
        <div class="kpi-label">Active Hosted Properties</div>
      </div>
    </div>

    <!-- Avg Rating & Occupancy -->
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="d-flex align-items-center justify-content-between">
          <div class="kpi-icon-wrap" style="background: rgba(108, 92, 231, 0.1); color: #6c5ce7;">
            <i class="fa-solid fa-star"></i>
          </div>
          <span class="badge bg-warning-subtle text-dark border rounded-pill px-2 py-1 small">
            Superhost
          </span>
        </div>
        <div class="kpi-value"><%= stats.avgRating %> ★</div>
        <div class="kpi-label">Guest Rating (<%= stats.occupancyRate %> Occupancy)</div>
      </div>
    </div>

  </div>

  <!-- ── 2 INTERACTIVE CHART.JS GRAPHS ── -->
  <div class="row g-4 mb-5">
    
    <!-- Monthly Revenue Trend -->
    <div class="col-lg-8">
      <div class="card rounded-4 p-4 border shadow-sm h-100" style="border-color: var(--border-color) !important; background: var(--bg-card);">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h5 class="fw-bold mb-1">Monthly Revenue Trend (INR)</h5>
            <small class="text-muted">Estimated rental turnover over the last 6 months</small>
          </div>
          <span class="badge bg-danger rounded-pill px-3 py-1">2026 Live Data</span>
        </div>
        <div style="height: 280px; position: relative;">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Category Distribution -->
    <div class="col-lg-4">
      <div class="card rounded-4 p-4 border shadow-sm h-100" style="border-color: var(--border-color) !important; background: var(--bg-card);">
        <h5 class="fw-bold mb-1">Portfolio Categories</h5>
        <small class="text-muted d-block mb-3">Listing distribution by property theme</small>
        <div style="height: 250px; position: relative;" class="d-flex align-items-center justify-content-center">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <!-- ── RECENT RESERVATIONS FEED ── -->
  <div class="card rounded-4 border shadow-sm mb-5 overflow-hidden" style="border-color: var(--border-color) !important; background: var(--bg-card);">
    <div class="d-flex align-items-center justify-content-between p-4 border-bottom" style="border-color: var(--border-color) !important;">
      <h5 class="fw-bold mb-0">Recent Guest Reservations</h5>
      <a href="/bookings/host/manage" class="btn btn-sm btn-outline-secondary rounded-pill px-3">View All</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
          <tr class="text-muted small">
            <th>Booking Code</th>
            <th>Property</th>
            <th>Guest</th>
            <th>Check-in / Out</th>
            <th>Payout</th>
            <th>Status</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentBookings.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">No reservations booked yet. Once guests book your stays, they will appear here.</td>
            </tr>
          <% } else { %>
            <% for (let b of recentBookings) { %>
              <tr>
                <td class="fw-bold"><%= b.bookingCode %></td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <% if (b.listing && b.listing.image) { %>
                      <img src="<%= b.listing.image.url %>" style="width: 36px; height: 36px; border-radius: 6px; object-fit: cover;" />
                    <% } %>
                    <span class="text-truncate fw-semibold" style="max-width: 180px;"><%= b.listing ? b.listing.title : 'Listing' %></span>
                  </div>
                </td>
                <td><%= b.guest ? b.guest.username : 'Guest' %></td>
                <td class="small">
                  <%= new Date(b.checkIn).toLocaleDateString("en-IN", { day:'numeric', month:'short' }) %> - <%= new Date(b.checkOut).toLocaleDateString("en-IN", { day:'numeric', month:'short' }) %>
                </td>
                <td class="fw-bold text-success">&#8377;<%= b.basePrice.toLocaleString("en-IN") %></td>
                <td>
                  <span class="badge <%= b.status === 'confirmed' ? 'bg-success' : (b.status === 'completed' ? 'bg-secondary' : 'bg-danger') %> rounded-pill">
                    <%= b.status %>
                  </span>
                </td>
                <td class="text-end">
                  <a href="/bookings/<%= b._id %>" class="btn btn-sm btn-dark rounded-pill px-3">
                    Invoice
                  </a>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── MY HOSTED PROPERTIES MANAGER ── -->
  <div class="card rounded-4 border shadow-sm p-4" style="border-color: var(--border-color) !important; background: var(--bg-card);">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h5 class="fw-bold mb-1">My Managed Properties (<%= listings.length %>)</h5>
        <small class="text-muted">Edit pricing, photos, amenities, or view guest reviews</small>
      </div>
      <a href="/listings/new" class="btn btn-danger rounded-pill px-4 btn-sm fw-bold" style="background: var(--primary-gradient); border: none;">
        + Add Listing
      </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for (let l of listings) { %>
        <div class="col">
          <div class="card rounded-4 border overflow-hidden shadow-sm h-100" style="border-color: var(--border-color) !important;">
            <img src="<%= l.image.url %>" style="height: 160px; object-fit: cover;" class="card-img-top" alt="<%= l.title %>" />
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <h6 class="fw-bold text-truncate mb-0" style="max-width: 200px;"><%= l.title %></h6>
                <span class="badge bg-light text-dark border small"><%= l.category || 'General' %></span>
              </div>
              <small class="text-muted d-block mb-2"><%= l.location %>, <%= l.country %></small>
              <div class="fw-bold text-danger mb-3">&#8377;<%= l.price.toLocaleString("en-IN") %> <span class="text-muted fw-normal small">/night</span></div>

              <div class="d-flex gap-2">
                <a href="/listings/<%= l._id %>" class="btn btn-sm btn-outline-dark rounded-pill flex-grow-1">View</a>
                <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-dark rounded-pill flex-grow-1">Edit</a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

</div>

<!-- ── INITIALIZE CHARTS SCRIPT ── -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Revenue Line Chart
    const revCtx = document.getElementById('revenueChart');
    if (revCtx) {
      new Chart(revCtx, {
        type: 'line',
        data: {
          labels: <%- chartData.monthlyLabels %>,
          datasets: [{
            label: 'Monthly Earnings (₹)',
            data: <%- chartData.monthlyData %>,
            borderColor: '#ff385c',
            backgroundColor: 'rgba(255, 56, 92, 0.1)',
            fill: true,
            tension: 0.4,
            borderWidth: 3,
            pointBackgroundColor: '#ff385c',
            pointRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(val) { return '₹' + val.toLocaleString(); }
              }
            }
          }
        }
      });
    }

    // 2. Category Doughnut Chart
    const catCtx = document.getElementById('categoryChart');
    if (catCtx) {
      new Chart(catCtx, {
        type: 'doughnut',
        data: {
          labels: <%- chartData.categoryLabels %>,
          datasets: [{
            data: <%- chartData.categoryData %>,
            backgroundColor: ['#ff385c', '#008489', '#ffb400', '#6c5ce7', '#00cec9', '#fd79a8'],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          }
        }
      });
    }
  });
</script>
