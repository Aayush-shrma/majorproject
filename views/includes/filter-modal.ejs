<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-4 border-0 shadow-lg" style="background: var(--bg-card); color: var(--text-main);">
      
      <!-- Modal Header -->
      <div class="modal-header border-bottom px-4 py-3" style="border-color: var(--border-color) !important;">
        <h5 class="modal-title fw-bold" id="filterModalLabel">
          <i class="fa-solid fa-sliders me-2 text-danger"></i>Filter Properties
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/listings" method="GET" id="advancedFilterForm">
        <!-- Preserve existing search keyword if present -->
        <% if (typeof search !== 'undefined' && search) { %>
          <input type="hidden" name="search" value="<%= search %>">
        <% } %>

        <div class="modal-body px-4 py-3" style="max-height: 70vh; overflow-y: auto;">
          
          <!-- ── SORT BY ── -->
          <div class="mb-4">
            <label class="form-label fw-bold mb-2">Sort Results</label>
            <select name="sort" class="form-select rounded-3 py-2">
              <option value="trending" <%= typeof query !== 'undefined' && query.sort === 'trending' ? 'selected' : '' %>>⭐ Recommended / Trending</option>
              <option value="price_asc" <%= typeof query !== 'undefined' && query.sort === 'price_asc' ? 'selected' : '' %>>💵 Price: Low to High</option>
              <option value="price_desc" <%= typeof query !== 'undefined' && query.sort === 'price_desc' ? 'selected' : '' %>>💎 Price: High to Low</option>
              <option value="rating" <%= typeof query !== 'undefined' && query.sort === 'rating' ? 'selected' : '' %>>🌟 Highest Rated</option>
              <option value="newest" <%= typeof query !== 'undefined' && query.sort === 'newest' ? 'selected' : '' %>>✨ Newest Listings</option>
            </select>
          </div>

          <hr style="border-color: var(--border-color);">

          <!-- ── PRICE RANGE ── -->
          <div class="mb-4">
            <label class="form-label fw-bold mb-2">Price Range (per night)</label>
            <div class="row g-3 align-items-center">
              <div class="col-6">
                <label class="text-muted small">Minimum</label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input
                    type="number"
                    name="minPrice"
                    class="form-control rounded-end-3"
                    placeholder="500"
                    min="0"
                    value="<%= typeof query !== 'undefined' && query.minPrice ? query.minPrice : '' %>" />
                </div>
              </div>
              <div class="col-6">
                <label class="text-muted small">Maximum</label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input
                    type="number"
                    name="maxPrice"
                    class="form-control rounded-end-3"
                    placeholder="20000"
                    min="0"
                    value="<%= typeof query !== 'undefined' && query.maxPrice ? query.maxPrice : '' %>" />
                </div>
              </div>
            </div>
          </div>

          <hr style="border-color: var(--border-color);">

          <!-- ── ROOMS & BEDS ── -->
          <div class="mb-4">
            <label class="form-label fw-bold mb-2">Rooms & Beds</label>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="text-muted small">Min Bedrooms</label>
                <select name="bedrooms" class="form-select rounded-3">
                  <option value="">Any</option>
                  <option value="1" <%= typeof query !== 'undefined' && query.bedrooms === '1' ? 'selected' : '' %>>1+ Bedroom</option>
                  <option value="2" <%= typeof query !== 'undefined' && query.bedrooms === '2' ? 'selected' : '' %>>2+ Bedrooms</option>
                  <option value="3" <%= typeof query !== 'undefined' && query.bedrooms === '3' ? 'selected' : '' %>>3+ Bedrooms</option>
                  <option value="4" <%= typeof query !== 'undefined' && query.bedrooms === '4' ? 'selected' : '' %>>4+ Bedrooms</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="text-muted small">Min Guests</label>
                <select name="guests" class="form-select rounded-3">
                  <option value="">Any</option>
                  <option value="1" <%= typeof query !== 'undefined' && query.guests === '1' ? 'selected' : '' %>>1+ Guest</option>
                  <option value="2" <%= typeof query !== 'undefined' && query.guests === '2' ? 'selected' : '' %>>2+ Guests</option>
                  <option value="4" <%= typeof query !== 'undefined' && query.guests === '4' ? 'selected' : '' %>>4+ Guests</option>
                  <option value="6" <%= typeof query !== 'undefined' && query.guests === '6' ? 'selected' : '' %>>6+ Guests</option>
                </select>
              </div>
            </div>
          </div>

          <hr style="border-color: var(--border-color);">

          <!-- ── AMENITIES CHECKLIST ── -->
          <div class="mb-2">
            <label class="form-label fw-bold mb-3">Amenities</label>
            <div class="row g-2">
              <% const amenityOptions = [
                { name: "Wifi", icon: "fa-wifi" },
                { name: "Swimming Pool", icon: "fa-person-swimming" },
                { name: "Air conditioning", icon: "fa-snowflake" },
                { name: "Free parking", icon: "fa-square-parking" },
                { name: "Kitchen", icon: "fa-utensils" },
                { name: "Dedicated workspace", icon: "fa-laptop" },
                { name: "Mountain view", icon: "fa-mountain" },
                { name: "Beach access", icon: "fa-umbrella-beach" },
                { name: "Pet friendly", icon: "fa-paw" }
              ]; %>

              <% amenityOptions.forEach(opt => { 
                const isChecked = typeof query !== 'undefined' && (
                  query.amenities === opt.name || 
                  (Array.isArray(query.amenities) && query.amenities.includes(opt.name))
                );
              %>
                <div class="col-sm-6">
                  <div class="form-check p-2 rounded-3 border d-flex align-items-center gap-2" style="border-color: var(--border-color) !important;">
                    <input
                      class="form-check-input ms-0 me-2"
                      type="checkbox"
                      name="amenities"
                      value="<%= opt.name %>"
                      id="amenity_<%= opt.name.replace(/\s+/g, '') %>"
                      <%= isChecked ? 'checked' : '' %>>
                    <label class="form-check-label flex-grow-1" for="amenity_<%= opt.name.replace(/\s+/g, '') %>" style="cursor: pointer;">
                      <i class="fa-solid <%= opt.icon %> me-2 text-secondary"></i><%= opt.name %>
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

        </div>

        <!-- Modal Footer -->
        <div class="modal-footer d-flex justify-content-between border-top px-4 py-3" style="border-color: var(--border-color) !important;">
          <a href="/listings" class="btn btn-link text-decoration-none text-muted fw-semibold">
            Clear all filters
          </a>
          <button type="submit" class="btn btn-danger px-4 py-2 rounded-pill fw-bold" style="background: var(--primary-gradient); border: none;">
            Show matching stays
          </button>
        </div>

      </form>
    </div>
  </div>
</div>
