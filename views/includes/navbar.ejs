<nav class="navbar navbar-expand-md navbar-custom sticky-top">
  <div class="container-fluid px-3 px-md-5">

    <!-- ── BRAND LOGO ── -->
    <a class="brand-logo-wrap" href="/listings">
      <i class="fa-solid fa-compass brand-logo-icon"></i>
      <span>Wanderlust</span>
    </a>

    <!-- ── CENTER EXPANDABLE SEARCH BAR ── -->
    <div class="d-none d-lg-flex flex-grow-1 justify-content-center px-4">
      <form
        action="/listings"
        method="GET"
        class="search-pill-bar d-flex align-items-center w-100"
        style="max-width: 620px; height: 50px; padding: 4px 6px;">

        <!-- Where -->
        <div class="d-flex flex-column justify-content-center px-3 flex-grow-1" style="min-width: 0;">
          <label class="search-field-label">Where</label>
          <input
            type="text"
            name="search"
            placeholder="Search destinations, cities, or stays..."
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            class="search-field-input"
            autocomplete="off" />
        </div>

        <div style="width: 1px; height: 28px; background: var(--border-color);" class="flex-shrink-0"></div>

        <!-- Guests -->
        <div class="d-flex flex-column justify-content-center px-3" style="min-width: 110px;">
          <label class="search-field-label">Guests</label>
          <input
            type="number"
            name="guests"
            min="1"
            max="20"
            placeholder="Add guests"
            value="<%= typeof query !== 'undefined' && query.guests ? query.guests : '' %>"
            class="search-field-input" />
        </div>

        <!-- Search Button -->
        <button type="submit" class="search-submit-btn flex-shrink-0" title="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <!-- ── RIGHT CONTROLS & USER MENU ── -->
    <div class="d-flex align-items-center gap-2 gap-md-3 ms-auto">

      <!-- Advanced Filter Trigger Button -->
      <button
        class="btn btn-outline-secondary rounded-pill px-3 py-2 d-flex align-items-center gap-2"
        type="button"
        data-bs-toggle="modal"
        data-bs-target="#filterModal"
        style="font-size: 0.85rem; font-weight: 600; border-color: var(--border-color); color: var(--text-main);">
        <i class="fa-solid fa-sliders"></i>
        <span class="d-none d-sm-inline">Filters</span>
      </button>

      <!-- Theme Switcher (Dark / Light Mode) -->
      <button
        class="btn rounded-circle d-flex align-items-center justify-content-center"
        id="themeToggleBtn"
        type="button"
        title="Toggle Theme"
        style="width: 40px; height: 40px; border: 1px solid var(--border-color); color: var(--text-main); background: var(--bg-card);">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>

      <!-- Wishlist Heart Shortcut (if logged in) -->
      <% if (currUser) { %>
        <a
          href="/wishlists"
          class="btn rounded-circle position-relative d-flex align-items-center justify-content-center"
          title="Wishlists"
          style="width: 40px; height: 40px; border: 1px solid var(--border-color); color: var(--primary); background: var(--bg-card);">
          <i class="fa-solid fa-heart"></i>
          <% if (typeof wishlistCount !== 'undefined' && wishlistCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="navWishlistBadge" style="font-size: 0.65rem;">
              <%= wishlistCount %>
            </span>
          <% } %>
        </a>
      <% } %>

      <!-- Host CTA -->
      <a href="/listings/new" class="d-none d-md-block text-decoration-none fw-semibold px-3 py-2 rounded-pill" style="font-size: 0.88rem; color: var(--text-main);">
        Host your home
      </a>

      <!-- User Dropdown Menu -->
      <div class="dropdown">
        <button
          class="btn user-menu-btn"
          type="button"
          id="userMenuDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false">
          <i class="fa-solid fa-bars" style="font-size: 0.9rem;"></i>
          <div class="user-avatar-badge">
            <% if (currUser) { %>
              <%= currUser.username[0].toUpperCase() %>
            <% } else { %>
              <i class="fa-solid fa-user" style="font-size: 0.75rem;"></i>
            <% } %>
          </div>
        </button>

        <ul class="dropdown-menu dropdown-menu-end rounded-4 py-2 mt-2" style="min-width: 250px;">
          <% if (!currUser) { %>
            <li>
              <a class="dropdown-item fw-bold py-2 d-flex align-items-center gap-3" href="/signup">
                <i class="fa-solid fa-user-plus text-primary"></i> Sign up
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/login">
                <i class="fa-solid fa-right-to-bracket text-secondary"></i> Log in
              </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/help">
                <i class="fa-regular fa-circle-question text-muted"></i> Help Centre
              </a>
            </li>
          <% } else { %>
            <li class="px-3 py-2 border-bottom mb-1">
              <div class="fw-bold" style="font-size: 0.92rem;"><%= currUser.username %></div>
              <small class="text-muted"><%= currUser.email %></small>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3 fw-semibold" href="/bookings">
                <i class="fa-solid fa-suitcase-rolling text-primary"></i> My Trips & Bookings
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/wishlists">
                <i class="fa-solid fa-heart text-danger"></i> Wishlists
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/dashboard">
                <i class="fa-solid fa-chart-line text-success"></i> Host Analytics Dashboard
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/bookings/host/manage">
                <i class="fa-solid fa-calendar-check text-info"></i> Manage Reservations
              </a>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/listings/new">
                <i class="fa-solid fa-house-chimney-medical text-primary"></i> List a new property
              </a>
            </li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3" href="/help">
                <i class="fa-regular fa-circle-question text-muted"></i> Help Centre
              </a>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li>
              <a class="dropdown-item py-2 d-flex align-items-center gap-3 text-danger fw-semibold" href="/logout">
                <i class="fa-solid fa-right-from-bracket"></i> Log out
              </a>
            </li>
          <% } %>
        </ul>
      </div>

    </div>
  </div>
</nav>