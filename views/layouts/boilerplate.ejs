<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wanderlust | Luxury Property Hosting & Next-Gen Booking</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>">

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Rating CSS -->
  <link rel="stylesheet" href="/css/rating.css">

  <!-- Mapbox GL CSS -->
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.1.2/mapbox-gl.css" rel="stylesheet">
  
  <!-- Leaflet CSS (Map Fallback) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

  <!-- Chart.js 4.4 -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Early Theme Setter to Prevent Flash -->
  <script>
    (function() {
      const savedTheme = localStorage.getItem('wanderlust_theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>

<body>

  <!-- Navbar Partial -->
  <%- include("../includes/navbar.ejs") %>

  <!-- Main Container -->
  <main class="main-content">
    <div class="container-fluid px-3 px-md-5 pt-3">
      <%- include("../includes/flash.ejs") %>
    </div>
    <%- body %>
  </main>

  <!-- Advanced Multi-Filter Modal -->
  <%- include("../includes/filter-modal.ejs") %>

  <!-- WanderBot AI Travel Assistant Widget -->
  <%- include("../includes/ai-assistant.ejs") %>

  <!-- Modern Floating Toast Container -->
  <div class="modern-toast-container" id="toastContainer"></div>

  <!-- Footer Partial -->
  <%- include("../includes/footer.ejs") %>

  <!-- Bootstrap 5.3 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Mapbox GL JS -->
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.1.2/mapbox-gl.js"></script>

  <!-- Leaflet JS (Fallback) -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <!-- WanderBot AI Client Script -->
  <script src="/js/ai-assistant.js"></script>

  <!-- Main Global Client Script -->
  <script src="/js/script.js"></script>

</body>
</html>