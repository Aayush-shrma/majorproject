<% layout("layouts/boilerplate") %>

<div class="container my-5 text-center py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card border-0 shadow-lg rounded-4 p-5" style="background: var(--bg-card);">
        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
          <i class="fa-solid fa-triangle-exclamation fs-1"></i>
        </div>
        <h3 class="fw-bold mb-2">Oops! Something went wrong</h3>
        <p class="text-muted mb-4"><%= message || "We couldn't find the page or resource you were looking for." %></p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-bold" style="background: var(--primary-gradient); border: none;">
            <i class="fa-solid fa-house me-1"></i> Return Home
          </a>
          <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
            Go Back
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
