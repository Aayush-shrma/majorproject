<% layout("layouts/boilerplate") %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card shadow-sm border-0 rounded-4" style="background: var(--bg-card);">
        <div class="card-body p-4 p-md-5">

          <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
            <div>
              <h2 class="fw-bold mb-1">Edit Listing</h2>
              <p class="text-muted small mb-0">Update your property details, pricing, and amenities.</p>
            </div>
            <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
              <i class="fa-solid fa-xmark me-1"></i> Cancel
            </a>
          </div>

          <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

            <!-- ── BASIC DETAILS ── -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Property Title <span class="text-danger">*</span></label>
              <input name="listing[title]" type="text" class="form-control rounded-3 py-2" value="<%= listing.title %>" required />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              <textarea name="listing[description]" class="form-control rounded-3" rows="4" required><%= listing.description %></textarea>
            </div>

            <!-- ── IMAGE EDIT ── -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Current Image</label>
              <div class="mb-2">
                <img src="<%= originalImageUrl %>" class="img-fluid rounded-3" style="max-height: 180px; object-fit: cover;" alt="listing" />
              </div>
              <div class="row g-2">
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Upload New Image File (Optional)</label>
                  <input name="listing[image]" type="file" class="form-control rounded-3 py-2" accept="image/*" />
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold small">Or Enter New Photo URL</label>
                  <input name="listing[imageUrl]" type="url" class="form-control rounded-3 py-2" placeholder="https://images.unsplash.com/..." />
                </div>
              </div>
            </div>

            <!-- ── CATEGORY ── -->
            <div class="mb-3">
              <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
              <select name="listing[category]" class="form-select rounded-3 py-2" required>
                <% const categories = [
                  { val: "trending", label: "🔥 Trending" },
                  { val: "amazing-pools", label: "🏊 Amazing Pools" },
                  { val: "mountains", label: "⛰️ Mountains" },
                  { val: "iconic-cities", label: "🏙️ Iconic Cities" },
                  { val: "castles", label: "🏰 Castles & Heritage" },
                  { val: "camping", label: "⛺ Camping & Treehouses" },
                  { val: "farms", label: "🐄 Organic Farms" },
                  { val: "arctic", label: "❄️ Arctic & Snow" },
                  { val: "domes", label: "🏠 Geodesic Domes" },
                  { val: "boats", label: "🚢 Luxury Houseboats" },
                  { val: "rooms", label: "🛏️ Private Rooms" },
                  { val: "luxury", label: "💎 Ultra Luxury" }
                ]; %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.val %>" <%= listing.category === cat.val ? 'selected' : '' %>><%= cat.label %></option>
                <% }); %>
              </select>
            </div>

            <!-- ── PRICING & ROOMS ── -->
            <div class="row g-3 mb-3">
              <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small">Price / night (₹)</label>
                <input name="listing[price]" type="number" min="100" class="form-control rounded-3 py-2" value="<%= listing.price %>" required />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small">Max Guests</label>
                <input name="listing[maxGuests]" type="number" min="1" class="form-control rounded-3 py-2" value="<%= listing.maxGuests || 2 %>" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small">Bedrooms</label>
                <input name="listing[bedrooms]" type="number" min="1" class="form-control rounded-3 py-2" value="<%= listing.bedrooms || 1 %>" />
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label fw-semibold small">Bathrooms</label>
                <input name="listing[bathrooms]" type="number" min="1" class="form-control rounded-3 py-2" value="<%= listing.bathrooms || 1 %>" />
              </div>
            </div>

            <!-- ── LOCATION ── -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-semibold small">City / Location</label>
                <input name="listing[location]" type="text" class="form-control rounded-3 py-2" value="<%= listing.location %>" required />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold small">Country</label>
                <input name="listing[country]" type="text" class="form-control rounded-3 py-2" value="<%= listing.country %>" required />
              </div>
            </div>

            <!-- ── AMENITIES ── -->
            <h6 class="fw-bold text-uppercase text-danger small mt-4 mb-3">Amenities Available</h6>
            <div class="row g-2 mb-4">
              <% const allAmenities = ["Wifi", "Swimming Pool", "Air conditioning", "Free parking", "Kitchen", "Dedicated workspace", "Mountain view", "Beach access", "Pet friendly", "Fireplace"]; %>
              <% allAmenities.forEach(am => { 
                const isSelected = listing.amenities && listing.amenities.includes(am);
              %>
                <div class="col-6 col-md-4">
                  <div class="form-check p-2 border rounded-3 d-flex align-items-center gap-2" style="border-color: var(--border-color) !important;">
                    <input class="form-check-input ms-0 me-2" type="checkbox" name="listing[amenities]" value="<%= am %>" id="edit_am_<%= am.replace(/\s+/g, '') %>" <%= isSelected ? 'checked' : '' %>>
                    <label class="form-check-label small" for="edit_am_<%= am.replace(/\s+/g, '') %>" style="cursor: pointer;"><%= am %></label>
                  </div>
                </div>
              <% }); %>
            </div>

            <button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-pill shadow">
              <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
            </button>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>